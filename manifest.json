{
  "id": "hyperflux-battery",
  "name": "Mouse Battery",
  "version": "0.1.0",
  "author": "Copilot \u003c223556219+Copilot@users.noreply.github.com\u003e",
  "description": "Mouse battery percentage and charging status from HyperFlux Next V2.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 320
  },
  "files": [
    "service/Status.js",
    "tests/status.test.cjs",
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": [
      "glyph"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Mouse Battery",
    "bar": {
      "section": "right"
    }
  },
  "dependencies": {
    "commands": ["hyperfluxctl", "timeout"]
  },
  "metadata": {
    "settings": [
      {
        "key": "pollSeconds",
        "type": "int",
        "label": "Refresh interval (seconds)",
        "group": "Mouse Battery",
        "default": 15,
        "min": 5,
        "max": 300
      }
    ]
  }
}
